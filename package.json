{
  "name": "smartpath-cursor-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "tutor-core",
    "mock-smartpath",
    "chrome-extension",
    "optional-ai-proxy"
  ],
  "scripts": {
    "generate:pdf": "node scripts/generate-pdf.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "dev": "npm run dev -w mock-smartpath",
    "dev:proxy": "npm run dev -w optional-ai-proxy",
    "build": "npm run build -w chrome-extension && npm run build -w mock-smartpath",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "npm run build -w chrome-extension && playwright test",
    "build:unified": "node scripts/build-unified.mjs",
    "start": "python server/p2_server.py"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "pdf-lib": "1.17.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  }
}
