  "quiz": {
    "id": "q-ldr-1",
    "conceptId": "ldr",
    "question": "R2 contains x4000, and Memory[x4000] contains 7. What is R1 after LDR R1, R2, #0?",
    "choices": [
      {
        "id": "A",
        "text": "x4000"
      },
      {
        "id": "B",
        "text": "7"
      },
      {
        "id": "C",
        "text": "0"
      },
      {
        "id": "D",
        "text": "The program counter"
      }
    ],
    "correctChoice": "B",
    "explanation": "LDR computes x4000 + 0 and loads Memory[x4000], which is 7."
  },
  "lesson": {
    "planId": "fixture-ldr-v1",
