{
  "manifest_version": 3,
  "name": "SmartPath Live — Mock Extension",
  "description": "A visible AI cursor companion for the standalone SmartPathAI learning workspace fixture.",
  "version": "0.2.0",
  "permissions": [
    "sidePanel",
    "tabs",
    "storage",
    "contextMenus",
    "activeTab",
    "scripting",
    "offscreen"
  ],
  "optional_permissions": [
    "debugger"
  ],
  "host_permissions": [
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open SmartPath Live controls"
  },
  "commands": {
    "stop-lesson": {
      "suggested_key": {
        "default": "Ctrl+Shift+Period",
        "mac": "Command+Shift+Period"
      },
      "description": "Stop the SmartPath lesson"
    },
    "pause-lesson": {
      "suggested_key": {
        "default": "Ctrl+Shift+Comma",
        "mac": "Command+Shift+Comma"
      },
      "description": "Pause the SmartPath lesson"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "js": [
        "content-bundle.js"
      ],
      "run_at": "document_idle"
    }
  ]
}