{
  "manifest_version": 3,
  "name": "SmartPath Live",
  "description": "AI cursor tutor for the SmartPath study workspace: LC-3 PDF lessons, Cursor Tutor (gradient descent), PDF import, web explain, voice.",
  "version": "0.3.0",
  "permissions": [
    "sidePanel",
    "tabs",
    "storage",
    "contextMenus",
    "activeTab",
    "scripting",
    "offscreen"
  ],
  "optional_permissions": [
    "debugger"
  ],
  "host_permissions": [
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open SmartPath Live controls",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "commands": {
    "stop-lesson": {
      "suggested_key": {
        "default": "Ctrl+Shift+Period",
        "mac": "Command+Shift+Period"
      },
      "description": "Stop the SmartPath lesson"
    },
    "pause-lesson": {
      "suggested_key": {
        "default": "Ctrl+Shift+Comma",
        "mac": "Command+Shift+Comma"
      },
      "description": "Pause the SmartPath lesson"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "js": [
        "content-bundle.js"
      ],
      "run_at": "document_idle",
      "exclude_matches": [
        "http://localhost:5173/tutor/*",
        "http://127.0.0.1:5173/tutor/*"
      ]
    },
    {
      "matches": [
        "http://localhost:5173/tutor/*"
      ],
      "js": [
        "tutor-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
