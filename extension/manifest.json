{
  "manifest_version": 3,
  "name": "SmartPath Live — Mock Extension",
  "description": "A visible AI cursor companion for the standalone SmartPathAI learning workspace fixture.",
  "version": "0.1.0",
  "permissions": ["sidePanel", "tabs"],
  "host_permissions": ["http://localhost:5173/*", "http://127.0.0.1:5173/*"],
  "background": {"service_worker":"background.js"},
  "side_panel": {"default_path":"sidepanel.html"},
  "action": {"default_title":"Open SmartPath Live controls"},
  "content_scripts": [
    {"matches":["http://localhost:5173/*","http://127.0.0.1:5173/*"],"js":["content.js"],"run_at":"document_idle"}
  ]
}
