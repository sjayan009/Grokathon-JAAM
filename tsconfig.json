{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2024", "ESNext.Array", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "types": ["chrome", "node", "vite/client"]
  },
  "include": ["tutor-core/src", "mock-smartpath/src", "chrome-extension/src", "optional-ai-proxy", "e2e"]
}
