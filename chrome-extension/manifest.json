{
  "manifest_version": 3,
  "name": "Smart Path Study Companion",
  "version": "0.1.0",
  "description": "An AI tutor cursor for the Smart Path study workspace demo.",
  "minimum_chrome_version": "120",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Show or hide the Study Companion",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:5173/*", "http://localhost:8787/*"],
  "content_scripts": [
    {
      "matches": ["http://localhost:5173/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
